# ========================================================
# FEXA BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ========================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the active .env file containing real secret keys.

# Environment Mode: "production" for Render deployment, "development" for local work
NODE_ENV=production

# Server Port (Render sets this dynamically, defaults to 5000 locally)
PORT=5000

# MongoDB Atlas Connection URI
# Ensure Network Access in MongoDB Atlas allows 0.0.0.0/0 (required for Render)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JSON Web Token Secret (Use a strong, 64-character random string)
JWT_SECRET=your_jwt_secret_key_change_in_production

# CORS & Frontend Origins (Without trailing slashes; supports comma-separated list)
CLIENT_URL=https://your-frontend-app.vercel.app
FRONTEND_URL=https://your-frontend-app.vercel.app

# Google OAuth 2.0 Web Client ID
# Must match VITE_GOOGLE_CLIENT_ID on the frontend
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# AWS S3 Storage (ap-south-1 Mumbai)
# On AWS EC2 with an attached IAM Role, AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are NOT needed.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=fexa-media-production
# For local development only (optional):
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Cloudinary Cloud Image Storage (Supported alongside S3 for legacy assets)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (Nodemailer Gmail SMTP for OTP verification)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_16_character_app_password

# Initial Seed Admin Account (Used only on first startup if no admin exists)
ADMIN_EMAIL=admin@fexa.com
ADMIN_PASSWORD=your_initial_admin_password
